{
  "name": "vm-software-ai-assurance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ValueMomentum Software & AI Assurance website (React + Vite front end, Express back end)",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite build && node server/index.js"
  },
  "dependencies": {
    "express": "4.21.1",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "vite": "5.4.11"
  }
}
